        <mxCell id="fp_Lvn0F3cJKW94ARfaZ-51" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Event Driven Architecture of Manage Exchange Rate&lt;/h1&gt;&lt;p&gt;&lt;b&gt;Fase 1&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Arquitectura basado en eventos que administra la consulta del tipo de cambio mediante un DNI o RUC&lt;/p&gt;&lt;p&gt;Se usa las siguientes tecnologías:&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;RxJava Spring Boot&lt;/li&gt;&lt;li&gt;MongoDB&lt;/li&gt;&lt;li&gt;Apache Kafka&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
